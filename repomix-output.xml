<file path="src/style.css">
:root {
  --night: #0e1330;
  --window: #26357a;
  --moon: #f2e9c9;
  --calm: #7fd4c1;
  --alarm: #ff5d5d;
  --rage: #d17bff;
  --frost: #6ee7ff;
  --ember: #ff8a5c;
  --ink: #e8ebff;
  font-family: ui-rounded, 'Nunito', 'Trebuchet MS', system-ui, sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  background:
    radial-gradient(ellipse 60% 55% at 78% 18%, var(--window) 0%, transparent 70%),
    radial-gradient(circle at 12% 90%, #1a2250 0%, transparent 55%), var(--night);
  color: var(--ink);
  user-select: none;
  -webkit-user-select: none;
  -webkit-tap-highlight-color: transparent;
}

/* Лёгкая виньетка — глубина ночной комнаты. */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse 90% 90% at 50% 45%, transparent 55%, rgba(2, 4, 16, 0.4) 100%);
}

#game {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  cursor: crosshair;
  touch-action: none;
}

/* ------------------------------------------------------------- HUD */
#hud {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 14px 16px;
  pointer-events: none;
  z-index: 2;
}

.hud-row {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
}

.timer {
  min-width: 4.2ch;
  font-size: 2.1rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--moon);
  transform-origin: left center;
}

.timer.danger {
  color: var(--alarm);
}

.timer.penalty {
  animation: penalty 0.4s ease-out;
}

.timer.bonus {
  animation: bonus 0.5s ease-out;
}

@keyframes bonus {
  0% {
    color: var(--calm);
    transform: scale(1.35);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes penalty {
  0% {
    color: var(--alarm);
    transform: scale(1.35) translateX(-3px);
  }
  25% {
    transform: scale(1.35) translateX(3px);
  }
  50% {
    transform: scale(1.2) translateX(-2px);
  }
  100% {
    transform: scale(1) translateX(0);
  }
}

.sleep {
  flex: 1;
  min-width: 0;
}

.sleep-label {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 0.85rem;
  margin-bottom: 4px;
  opacity: 0.8;
}

.phase {
  font-weight: 800;
  color: var(--calm);
}

.phase.p2 {
  color: var(--rage);
}

.bar {
  position: relative;
  height: 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
}

.bar-fill {
  height: 100%;
  width: 0%;
  border-radius: 999px;
  background: linear-gradient(90deg, #5a7bd8, var(--calm));
  transition: width 0.2s ease-out;
}

.bar-fill.p2 {
  background: linear-gradient(90deg, #5a7bd8, var(--rage));
}

/* Отметка на шкале: где начинается фаза 2. */
.bar-mark {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 2px;
  background: rgba(255, 255, 255, 0.4);
}

.face {
  width: 40px;
  height: 40px;
  color: var(--moon);
  flex: none;
}

.face svg {
  width: 40px;
  height: 40px;
  display: block;
}

.mute {
  pointer-events: auto;
  border: 0;
  background: rgba(255, 255, 255, 0.1);
  color: inherit;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  flex: none;
  display: grid;
  place-items: center;
  transition: background 0.15s ease;
}

.mute svg {
  width: 20px;
  height: 20px;
  display: block;
}

.mute:hover {
  background: rgba(255, 255, 255, 0.2);
}

#mute .slash {
  display: none;
}

#mute.muted .waves {
  display: none;
}

#mute.muted .slash {
  display: block;
}

#mute.muted {
  color: rgba(232, 235, 255, 0.55);
}

/* Чипы эффектов под шапкой. */
.hud-effects {
  max-width: 760px;
  margin: 10px auto 0;
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 11px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  background: rgba(10, 14, 36, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(4px);
}

.chip[hidden] {
  display: none;
}

.chip svg {
  width: 14px;
  height: 14px;
  flex: none;
}

.chip-t {
  font-variant-numeric: tabular-nums;
}

.chip.slow {
  color: #bff3ff;
  border-color: rgba(110, 231, 255, 0.55);
  background: rgba(18, 52, 82, 0.6);
}

.chip.frost {
  color: #9fe8ff;
  border-color: rgba(110, 231, 255, 0.4);
}

.chip.bomb {
  color: #ffb3a0;
  border-color: rgba(255, 107, 107, 0.45);
}

/* --------------------------------------------------------- оверлей */
.overlay {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(8, 10, 28, 0.55);
  backdrop-filter: blur(3px);
  z-index: 3;
}

.overlay[hidden],
#hud[hidden],
.btn[hidden],
#legend[hidden],
#menu-hint[hidden] {
  display: none;
}

.overlay.paused {
  background: rgba(8, 10, 28, 0.78);
  backdrop-filter: blur(9px);
}

/* Победа: сцена засыпания остаётся видимой за карточкой. */
.overlay.won {
  background: rgba(8, 10, 28, 0.3);
  backdrop-filter: blur(2px);
}

.card {
  max-width: 460px;
  width: 100%;
  max-height: calc(100dvh - 40px);
  overflow-y: auto;
  padding: 30px 30px 28px;
  border-radius: 20px;
  background: linear-gradient(160deg, #1a2152 0%, #151b45 55%, #12163a 100%);
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, 0.1),
    0 24px 60px rgba(0, 0, 0, 0.5);
  text-align: left;
  scrollbar-width: thin;
  scrollbar-color: rgba(242, 233, 201, 0.35) rgba(255, 255, 255, 0.06);
}

.card::-webkit-scrollbar {
  width: 10px;
}

.card::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999px;
}

.card::-webkit-scrollbar-thumb {
  background: rgba(242, 233, 201, 0.3);
  border-radius: 999px;
  border: 2px solid #151b45;
}

.card::-webkit-scrollbar-thumb:hover {
  background: rgba(242, 233, 201, 0.5);
}

.overlay:not([hidden]) .card {
  animation: cardIn 0.45s cubic-bezier(0.22, 1.2, 0.36, 1) both;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(26px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.ov-icon {
  width: 84px;
  height: 84px;
  margin-bottom: 14px;
}

.ov-icon svg {
  width: 84px;
  height: 84px;
  display: block;
}

.overlay.won .ov-icon {
  filter: drop-shadow(0 0 18px rgba(242, 233, 201, 0.35));
}

.overlay.won .ov-icon svg {
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-5px);
  }
}

/* Плавающие «z» в SVG-эмблемах и лице. */
.z {
  transform-box: fill-box;
  transform-origin: center;
  animation: zfloat 2.8s ease-in-out infinite;
}

.z2 {
  animation-delay: 0.45s;
}

.z3 {
  animation-delay: 0.9s;
}

@keyframes zfloat {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(2px);
  }
  50% {
    opacity: 1;
    transform: translateY(-2px);
  }
}

.card h1 {
  margin: 0 0 12px;
  font-size: 2rem;
  line-height: 1.15;
  color: var(--moon);
}

.card p {
  margin: 0 0 14px;
  line-height: 1.55;
  max-width: 60ch;
}

.card .stats {
  color: var(--calm);
  font-weight: 700;
}

.card .stats:empty {
  display: none;
}

.card .hint {
  font-size: 0.82rem;
  opacity: 0.65;
  margin-bottom: 16px;
}

/* Легенда комаров в меню. */
.legend {
  list-style: none;
  margin: 4px 0 14px;
  padding: 0;
  display: grid;
  gap: 8px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 12px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-left-width: 3px;
}

.legend-item.normal {
  border-left-color: #9a8fb8;
}

.legend-item.frost {
  border-left-color: var(--frost);
}

.legend-item.bomb {
  border-left-color: var(--alarm);
}

.legend-item svg {
  width: 36px;
  height: 36px;
  flex: none;
}

.legend-item b {
  display: block;
  font-size: 0.95rem;
  color: var(--moon);
}

.legend-item span {
  display: block;
  font-size: 0.8rem;
  line-height: 1.35;
  opacity: 0.75;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 6px;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  font: inherit;
  font-weight: 800;
  font-size: 1.05rem;
  color: #0e1330;
  background: var(--moon);
  border: 0;
  border-radius: 999px;
  cursor: pointer;
  transition: transform 0.12s ease;
}

.btn svg {
  width: 18px;
  height: 18px;
  flex: none;
}

.btn.secondary {
  color: var(--ink);
  background: rgba(255, 255, 255, 0.12);
}

.btn:hover {
  transform: scale(1.04);
}

.btn:active {
  transform: scale(0.97);
}

.btn:focus-visible,
.mute:focus-visible {
  outline: 3px solid var(--calm);
  outline-offset: 3px;
}

@media (max-width: 520px) {
  .timer {
    font-size: 1.6rem;
  }

  .face {
    display: none;
  }

  .card {
    padding: 24px 20px 22px;
  }

  .card h1 {
    font-size: 1.6rem;
  }

  .ov-icon,
  .ov-icon svg {
    width: 68px;
    height: 68px;
  }

  .chip {
    font-size: 0.72rem;
    padding: 4px 9px;
  }

  .legend-item span {
    font-size: 0.76rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .timer.penalty,
  .timer.bonus {
    animation: none;
  }

  .bar-fill {
    transition: none;
  }

  .overlay:not([hidden]) .card,
  .overlay.won .ov-icon svg,
  .z {
    animation: none;
  }
}
</file>

